                      ],
                      "Paths": null,
                      "Values": null,
                      "Name": "95Etc",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Climate.Weather, Models",
                          "ConstantsFile": null,
                          "FileName": "C:\\Users\\Amine\\workspace\\morocco_maize\\data\\cmip6\\renamed_files\\CNRM-CM6-1_time_series_corrected.met",
                          "ExcelWorkSheetName": "",
                          "Latitude": 30.56,
                          "Tav": 19.09,
                          "Amp": 14.63,
                          "Name": "Weather",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using System;",
                            "using Models.Core;",
                            "using Models.Interfaces;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] private Irrigation irrigation = null;",
                            "        [Link] private Clock clock = null;",
                            "        [Link] private ISummary summary = null;",
                            "        [Link] private IWeather weather = null;",
                            "        [Link] private ISoilWater soilWater = null;",
                            "",
                            "        // =======================",
                            "        // USER PARAMETERS",
                            "        // =======================",
                            "",
                            "        [Description(\"Crop to irrigate (e.g., Maize)\")]",
                            "        public IPlant Crop { get; set; }",
                            "",
                            "        [Description(\"Activate automation\")]",
                            "        public bool AutoIrrigationOn { get; set; } = true;",
                            "",
                            "        [Description(\"Decision interval (days). Keep same for all treatments if you don't want to change frequency.\")]",
                            "        public int IntervalDays { get; set; } = 2;",
                            "",
                            "        [Description(\"Treatment fraction (1.0, 0.75, 0.5 ...)\")]",
                            "        public double Fraction { get; set; } = 1.0;",
                            "",
                            "        [Description(\"Rain efficiency (0-1). EffRainRaw = max(0, Rain-Runoff) * RainEfficiency\")]",
                            "        public double RainEfficiency { get; set; } = 0.5;",
                            "",
                            "        [Description(\"Cap effective rain used in irrigation balance as fraction of ETc (0-1). 1 = no cap.\")]",
                            "        public double EffRainCapFracOfETc { get; set; } = 0.3;",
                            "",
                            "        [Description(\"Irrigation efficiency (0-1). Net ≈ Gross * Eff\")]",
                            "        public double IrrigationEfficiency { get; set; } = 1.0;",
                            "",
                            "        [Description(\"Max gross mm per event at FULL (100%). 0 = unlimited. (Ratio kept exact)\")]",
                            "        public double MaxIrrigation { get; set; } = 12.0;",
                            "",
                            "        [Description(\"Where APSIM places irrigation water in soil (mm from surface). 0 = surface.\")]",
                            "        public double ApplyDepthMm { get; set; } = 0.0;",
                            "",
                            "        // --- Kc curve (simple FAO-like)",
                            "        public double KcIni { get; set; } = 0.30;",
                            "        public double KcMid { get; set; } = 1.15;",
                            "        public double KcEnd { get; set; } = 0.60;",
                            "        public int DaysIni { get; set; } = 20;",
                            "        public int DaysDev { get; set; } = 30;",
                            "        public int DaysMid { get; set; } = 40;",
                            "        public int DaysLate { get; set; } = 30;",
                            "",
                            "        // --- irrigation window",
                            "        [Description(\"Start irrigation after DAS. 0 = start immediately\")]",
                            "        public int StartAfterDays { get; set; } = 0;",
                            "",
                            "        [Description(\"Stop irrigation after DAS. 0 = stop when crop ends\")]",
                            "        public int StopAfterDays { get; set; } = 85;",
                            "",
                            "        // --- IMPORTANT: fix DAS reference to sowing date (prevents emergence-based shift)",
                            "        [Description(\"Sowing month (used to define DAS=1 at sowing date).\")]",
                            "        public int SowingMonth { get; set; } = 3;",
                            "",
                            "        [Description(\"Sowing day (used to define DAS=1 at sowing date).\")]",
                            "        public int SowingDay { get; set; } = 23;",
                            "",
                            "        [Description(\"Write detailed messages\")]",
                            "        public bool Verbose { get; set; } = true;",
                            "",
                            "        // =======================",
                            "        // STATE",
                            "        // =======================",
                            "        private int daysSinceDecision = 0;",
                            "        private double sumETc = 0.0;",
                            "        private double sumEffRainRaw = 0.0;",
                            "",
                            "        private bool wasAlive = false;",
                            "        private DateTime cropStart;",
                            "",
                            "        private double seasonGrossIrr = 0.0;",
                            "        private double seasonETc = 0.0;",
                            "        private double seasonEffRainRaw = 0.0;",
                            "        private double seasonEffRainUsed = 0.0;",
                            "",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnStart(object sender, EventArgs e)",
                            "        {",
                            "            if (Crop == null) throw new Exception(\"Crop not linked.\");",
                            "            if (Fraction < 0 || Fraction > 1) throw new Exception(\"Fraction must be 0–1.\");",
                            "            if (IntervalDays < 1) throw new Exception(\"IntervalDays must be >= 1.\");",
                            "            if (RainEfficiency < 0 || RainEfficiency > 1) throw new Exception(\"RainEfficiency must be 0–1.\");",
                            "            if (EffRainCapFracOfETc < 0 || EffRainCapFracOfETc > 1) throw new Exception(\"EffRainCapFracOfETc must be 0–1.\");",
                            "            if (IrrigationEfficiency <= 0 || IrrigationEfficiency > 1) throw new Exception(\"IrrigationEfficiency must be (0,1].\");",
                            "            if (ApplyDepthMm < 0) throw new Exception(\"ApplyDepthMm must be >= 0.\");",
                            "            if (SowingMonth < 1 || SowingMonth > 12) throw new Exception(\"SowingMonth must be 1–12.\");",
                            "            if (SowingDay < 1 || SowingDay > 31) throw new Exception(\"SowingDay must be 1–31.\");",
                            "",
                            "            daysSinceDecision = 0;",
                            "            sumETc = 0.0;",
                            "            sumEffRainRaw = 0.0;",
                            "            wasAlive = false;",
                            "",
                            "            seasonGrossIrr = 0.0;",
                            "            seasonETc = 0.0;",
                            "            seasonEffRainRaw = 0.0;",
                            "            seasonEffRainUsed = 0.0;",
                            "",
                            "            summary?.WriteMessage(this,",
                            "                $\"ETc STRICT (soilWater.Eo*Kc): Fraction={Fraction:P0}, IntervalDays={IntervalDays}, StartAfterDays={StartAfterDays}, StopAfterDays={StopAfterDays}, \" +",
                            "                $\"RainEff={RainEfficiency:F2}, EffRainCapFracOfETc={EffRainCapFracOfETc:F2}, IrrEff={IrrigationEfficiency:F2}, \" +",
                            "                $\"MaxIrr(Full)={MaxIrrigation:F1}, ApplyDepthMm={ApplyDepthMm:F0}, Sowing={SowingDay:D2}/{SowingMonth:D2}\",",
                            "                MessageType.Information);",
                            "        }",
                            "",
                            "        [EventSubscribe(\"EndOfDay\")]",
                            "        private void OnEndOfDay(object sender, EventArgs e)",
                            "        {",
                            "            if (!AutoIrrigationOn || Crop == null) return;",
                            "",
                            "            // When crop becomes alive (often at emergence), force cropStart to sowing date",
                            "            if (Crop.IsAlive && !wasAlive)",
                            "            {",
                            "                cropStart = new DateTime(clock.Today.Year, SowingMonth, SowingDay);",
                            "                wasAlive = true;",
                            "",
                            "                if (Verbose)",
                            "                    summary?.WriteMessage(this,",
                            "                        $\"Crop alive on {clock.Today:d}. Using cropStart (sowing date) = {cropStart:d}\",",
                            "                        MessageType.Information);",
                            "            }",
                            "",
                            "            if (!Crop.IsAlive)",
                            "            {",
                            "                wasAlive = false;",
                            "                return;",
                            "            }",
                            "",
                            "            int das = (clock.Today - cropStart).Days + 1;",
                            "            if (das < 1) return; // before sowing date in that year",
                            "",
                            "            if (StartAfterDays > 0 && das < StartAfterDays) return;",
                            "            if (StopAfterDays > 0 && das > StopAfterDays) return;",
                            "",
                            "            // ETc estimate",
                            "            double eo = Math.Max(0.0, soilWater.Eo);",
                            "            double kc = GetKc(das);",
                            "            double etcToday = eo * kc;",
                            "",
                            "            // Raw effective rain (after efficiency)",
                            "            double effRainRaw = Math.Max(0.0, weather.Rain - soilWater.Runoff) * RainEfficiency;",
                            "",
                            "            sumETc += etcToday;",
                            "            sumEffRainRaw += effRainRaw;",
                            "",
                            "            seasonETc += etcToday;",
                            "            seasonEffRainRaw += effRainRaw;",
                            "        }",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            if (!AutoIrrigationOn || Crop == null || !Crop.IsAlive)",
                            "            {",
                            "                daysSinceDecision = 0;",
                            "                sumETc = 0.0;",
                            "                sumEffRainRaw = 0.0;",
                            "                return;",
                            "            }",
                            "",
                            "            int das = (clock.Today - cropStart).Days + 1;",
                            "            if (das < 1) return;",
                            "",
                            "            if (StartAfterDays > 0 && das < StartAfterDays) return;",
                            "            if (StopAfterDays > 0 && das > StopAfterDays) return;",
                            "",
                            "            daysSinceDecision++;",
                            "            if (daysSinceDecision < IntervalDays) return;",
                            "",
                            "            // Cap effective rain used in the balance",
                            "            double effRainUsed = sumEffRainRaw;",
                            "            if (EffRainCapFracOfETc < 1.0)",
                            "                effRainUsed = Math.Min(sumEffRainRaw, EffRainCapFracOfETc * sumETc);",
                            "",
                            "            seasonEffRainUsed += effRainUsed;",
                            "",
                            "            // Full net need over interval",
                            "            double fullNeedNet = Math.Max(0.0, sumETc - effRainUsed);",
                            "",
                            "            // Convert to gross at FULL",
                            "            double grossFull = (fullNeedNet > 0) ? (fullNeedNet / IrrigationEfficiency) : 0.0;",
                            "",
                            "            // Cap per event at FULL (keeps ratios exact)",
                            "            if (MaxIrrigation > 0 && grossFull > MaxIrrigation)",
                            "                grossFull = MaxIrrigation;",
                            "",
                            "            // Apply fraction AFTER capping => exact 100/75/50",
                            "            double gross = Fraction * grossFull;",
                            "",
                            "            if (gross > 0)",
                            "            {",
                            "                irrigation.Apply(gross, depth: ApplyDepthMm);",
                            "                seasonGrossIrr += gross;",
                            "",
                            "                if (Verbose)",
                            "                {",
                            "                    summary?.WriteMessage(this,",
                            "                        $\"Irr {clock.Today:d}: DAS={das} SumETc={sumETc:F1} EffRainRaw={sumEffRainRaw:F1} EffRainUsed={effRainUsed:F1} \" +",
                            "                        $\"FullNeedNet={fullNeedNet:F1} GrossFull={grossFull:F1} Fraction={Fraction:P0} Applied={gross:F1}\",",
                            "                        MessageType.Information);",
                            "                }",
                            "            }",
                            "",
                            "            // Reset interval sums (strict, no catch-up)",
                            "            daysSinceDecision = 0;",
                            "            sumETc = 0.0;",
                            "            sumEffRainRaw = 0.0;",
                            "        }",
                            "",
                            "        [EventSubscribe(\"EndOfSimulation\")]",
                            "        private void OnEnd(object sender, EventArgs e)",
                            "        {",
                            "            summary?.WriteMessage(this,",
                            "                $\"SEASON TOTALS: ETc={seasonETc:F1} mm, EffRainRaw={seasonEffRainRaw:F1} mm, EffRainUsed={seasonEffRainUsed:F1} mm, \" +",
                            "                $\"GrossIrr={seasonGrossIrr:F1} mm, Fraction={Fraction:P0}, IntervalDays={IntervalDays}, MaxIrr(Full)={MaxIrrigation:F1}\",",
                            "                MessageType.Information);",
                            "        }",
                            "",
                            "        private double GetKc(int das)",
                            "        {",
                            "            int d1 = Math.Max(1, DaysIni);",
                            "            int d2 = Math.Max(0, DaysDev);",
                            "            int d3 = Math.Max(0, DaysMid);",
                            "            int d4 = Math.Max(0, DaysLate);",
                            "",
                            "            if (das <= d1) return KcIni;",
                            "",
                            "            if (das <= d1 + d2 && d2 > 0)",
                            "            {",
                            "                double f = (das - d1) / (double)d2;",
                            "                return KcIni + f * (KcMid - KcIni);",
                            "            }",
                            "",
                            "            if (das <= d1 + d2 + d3) return KcMid;",
                            "",
                            "            if (das <= d1 + d2 + d3 + d4 && d4 > 0)",
                            "            {",
                            "                double f = (das - (d1 + d2 + d3)) / (double)d4;",
                            "                return KcMid + f * (KcEnd - KcMid);",
                            "            }",
                            "",
                            "            return KcEnd;",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "Crop",
                              "Value": "[Maize]"
                            },
                            {
                              "Key": "AutoIrrigationOn",
                              "Value": "True"
                            },
                            {
                              "Key": "IntervalDays",
                              "Value": "1"
                            },
                            {
                              "Key": "Fraction",
                              "Value": "0.95"
                            },
                            {
                              "Key": "RainEfficiency",
                              "Value": "1"
                            },
                            {
                              "Key": "EffRainCapFracOfETc",
                              "Value": "1"
                            },
                            {
                              "Key": "IrrigationEfficiency",
                              "Value": "1"
                            },
                            {
                              "Key": "MaxIrrigation",
                              "Value": "6"
                            },
                            {
                              "Key": "ApplyDepthMm",
                              "Value": "0"
                            },
                            {
                              "Key": "StartAfterDays",
                              "Value": "10"
                            },
                            {
                              "Key": "StopAfterDays",
                              "Value": "95"
                            },
                            {
                              "Key": "SowingMonth",
                              "Value": "3"
                            },
                            {
                              "Key": "SowingDay",
                              "Value": "23"
                            },
                            {
                              "Key": "Verbose",
                              "Value": "True"
                            }
                          ],
                          "Name": "IrrigationFraction",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
