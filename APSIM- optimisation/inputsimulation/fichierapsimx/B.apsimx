                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Fertiliser Fertiliser;",
                            "        [Link] Clock Clock;",
                            "",
                            "        [Description(\"Crop to be fertilised\")]",
                            "        public IPlant Crop { get; set; }",
                            "",
                            "        [Description(\"Type of fertiliser\")]",
                            "        [Display(Type = DisplayType.FertiliserType)]",
                            "        public string FertiliserType { get; set; } = \"NH4NO3N\";",
                            "",
                            "        [Description(\"1st application at sowing (kg/ha)\")]",
                            "        public double Amount1 { get; set; } = 70;",
                            "",
                            "        [Description(\"2nd application (kg/ha)\")]",
                            "        public double Amount2 { get; set; } = 100;",
                            "",
                            "        [Description(\"3rd application (kg/ha)\")]",
                            "        public double Amount3 { get; set; } = 80;",
                            "",
                            "        [Description(\"Days after sowing for 2nd application\")]",
                            "        public int DAS2 { get; set; } = 30;",
                            "",
                            "        [Description(\"Days after sowing for 3rd application\")]",
                            "        public int DAS3 { get; set; } = 55;",
                            "",
                            "        private DateTime sowingDate;",
                            "        private bool cropSown = false;",
                            "        private bool done2 = false;",
                            "        private bool done3 = false;",
                            "",
                            "        [EventSubscribe(\"Sowing\")]",
                            "        private void OnSowing(object sender, EventArgs e)",
                            "        {",
                            "            Model crop = sender as Model;",
                            "",
                            "            if (Crop != null && crop.Name.Equals((Crop as IModel).Name, StringComparison.OrdinalIgnoreCase))",
                            "            {",
                            "                cropSown = true;",
                            "                sowingDate = Clock.Today;",
                            "                done2 = false;",
                            "                done3 = false;",
                            "",
                            "                Fertiliser.Apply(amount: Amount1, type: FertiliserType);",
                            "            }",
                            "        }",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            if (!cropSown)",
                            "                return;",
                            "",
                            "            int das = (Clock.Today - sowingDate).Days;",
                            "",
                            "            if (!done2 && das >= DAS2)",
                            "            {",
                            "                Fertiliser.Apply(amount: Amount2, type: FertiliserType);",
                            "                done2 = true;",
                            "            }",
                            "",
                            "            if (!done3 && das >= DAS3)",
                            "            {",
                            "                Fertiliser.Apply(amount: Amount3, type: FertiliserType);",
                            "                done3 = true;",
                            "            }",
                            "        }",
                            "",
                            "        [EventSubscribe(\"Harvesting\")]",
                            "        private void OnHarvesting(object sender, EventArgs e)",
                            "        {",
                            "            cropSown = false;",
                            "        }",
                            "    }",
                            "}"
                          ],
