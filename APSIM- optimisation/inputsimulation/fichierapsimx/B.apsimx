                      "Name": "60Etc",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Climate.Weather, Models",
                          "ConstantsFile": null,
                          "FileName": "C:\\Users\\Amine\\workspace\\morocco_maize\\data\\cmip6\\renamed_files\\CNRM-CM6-1_time_series_corrected.met",
                          "ExcelWorkSheetName": "",
                          "Latitude": 30.56,
                          "Tav": 19.09,
                          "Amp": 14.63,
                          "Name": "Weather",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
