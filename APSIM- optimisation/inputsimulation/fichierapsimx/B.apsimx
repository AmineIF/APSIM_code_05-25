                              ],
                              "AirDry": [
                                0.12,
                                0.125,
                                0.14
                              ],
                              "LL15": [
                                0.137,
                                0.148,
                                0.159
                              ],
                              "DUL": [
                                0.354,
                                0.34,
                                0.334
                              ],
                              "SAT": [
                                0.449,
                                0.453,
                                0.445
                              ],
                              "KS": null,
                              "BDMetadata": [
