                          "Latitude": -20.074444,
                          "Longitude": 30.832778,
                          "LocationAccuracy": null,
                          "YearOfSampling": "0",
                          "DataSource": "",
                          "Comments": "",
                          "Name": "75mmsoil",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Soils.Physical, Models",
                              "Thickness": [
                                250.0,
                                250.0,
                                250.0
                              ],
                              "ParticleSizeSand": [
                                48.0,
                                44.0,
